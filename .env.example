# URL base del backend (Flask/FastAPI). Sin slash final.
VITE_API_BASE_URL=http://localhost:8000

# URL del canal WebSocket para estado/eventos/detecciones en vivo.
VITE_WS_URL=ws://localhost:8000/ws

# Ruta del stream MJPEG de la camara con overlay de detecciones YOLOv8.
# Se usa como src de un <img>: http://localhost:8000/api/video_feed
VITE_VIDEO_FEED_PATH=/api/video_feed

# Intervalo (ms) de polling de respaldo cuando el WebSocket no esta disponible.
VITE_POLL_INTERVAL_MS=1500

# Si es "true", el dashboard usa datos de ejemplo en vez de llamar al backend.
# Util para revisar el diseno sin tener el backend/Arduino conectados.
VITE_USE_MOCK_DATA=false
